{
  "name": "@event-mapping/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "cli": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup src/index.ts --watch --dts --format esm",
    "build": "tsup-node src/index.ts --format esm",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "new": "tsup-node src/index.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^12.1.0"
  },
  "devDependencies": {
    "@event-mapping/eslint-config": "workspace:*",
    "@event-mapping/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.2.4"
  }
}
