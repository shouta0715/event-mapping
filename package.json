{
  "name": "event-mapping",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "init:cli": "turbo build --filter='./cli'",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:apply": "turbo db:apply",
    "db:generate": "turbo db:generate",
    "db:studio": "turbo db:studio",
    "docs": "turbo dev --filter='./docs'",
    "new:event": "turbo run new",
    "dev:admin": "turbo dev --filter='./apps/admin'... --filter='./apps/api'...",
    "dev:canal-night": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/canal-night'... --filter='./apps/line/canal-night-liff-app'...",
    "dev:square": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/square'...",
    "dev:propeller": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/propeller'...",
    "dev:grid-text": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/grid-text'...",
    "dev:mouse-event": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/mouse-event'...",
    "dev:edge-touch": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/edge-touch'...",
    "dev:pikachu": "turbo dev --filter='./apps/admin'... --filter='./apps/api'... --filter='./apps/events/pikachu'..."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "turbo": "^2.1.1",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  }
}
